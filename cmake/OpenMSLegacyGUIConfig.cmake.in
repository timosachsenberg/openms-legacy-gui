@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt6 6.1 COMPONENTS Core Gui Widgets Svg OpenGLWidgets)
if(APPLE)
  find_dependency(Qt6 6.1 COMPONENTS PrintSupport)
endif()
if(@OPENMS_LEGACY_GUI_WEBENGINE_ENABLED@)
  find_dependency(Qt6 6.1 COMPONENTS WebEngineWidgets)
endif()
find_dependency(OpenMS 3.6...<3.7 CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/OpenMSLegacyGUITargets.cmake")
check_required_components(OpenMSLegacyGUI)
